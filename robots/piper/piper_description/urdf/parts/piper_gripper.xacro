<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_gripper">
  <xacro:macro name="piper_gripper"
    params="prefix:='' parent_link:='flange_link' description_pkg:='piper_description' xyz_ee:='0 0 0' rpy_ee:='0 0 0' tcp_xyz:='0 0 0' tcp_rpy:='0 0 0'">
    <xacro:property name="joint_limits" value="${xacro.load_yaml('$(find piper_description)/config/joint_limits.yaml')}"/>
    <xacro:property name="gripper_main_l" value="${joint_limits['gripper_joint1']['limit']['lower']}"/>
    <xacro:property name="gripper_main_u" value="${joint_limits['gripper_joint1']['limit']['upper']}"/>
    <link name="${prefix}gripper_base">
      <inertial>
        <origin xyz="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876" rpy="0 0 0"/>
        <mass value="0.45"/>
        <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/piper_gripper/visual/gripper_base.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/piper_gripper/collision/gripper_base.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <origin xyz="${xyz_ee}" rpy="${rpy_ee}"/>
      <!-- parent_link is absolute (do not apply prefix). Marvin uses flange_L;
           Piper arms use left_flange_link / flange_link. -->
      <parent link="${parent_link}"/>
      <child link="${prefix}gripper_base"/>
    </joint>

    <!-- Fixed TCP frame (对齐 Franka hand_tcp 语义) -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <origin xyz="${tcp_xyz}" rpy="${tcp_rpy}"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_tcp"/>
    </joint>

    <link name="${prefix}gripper_link1">
      <inertial>
        <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
        <mass value="0.025"/>
        <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/piper_gripper/visual/gripper_link1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/piper_gripper/collision/gripper_link1.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}gripper_joint1" type="prismatic">
      <origin xyz="0 0 0.1358" rpy="1.5707963 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="${joint_limits['gripper_joint1']['limit']['lower']}"
             upper="${joint_limits['gripper_joint1']['limit']['upper']}"
             effort="${joint_limits['gripper_joint1']['limit']['effort']}"
             velocity="${joint_limits['gripper_joint1']['limit']['velocity']}"/>
    </joint>

    <link name="${prefix}gripper_link2">
      <inertial>
        <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
        <mass value="0.025"/>
        <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/piper_gripper/visual/gripper_link2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/piper_gripper/collision/gripper_link2.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}gripper_joint2" type="prismatic">
      <origin xyz="0 0 0.1358" rpy="1.5707963 0 -3.1415926"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_link2"/>
      <axis xyz="0 0 -1"/>
      <limit lower="${-gripper_main_u}"
             upper="${-gripper_main_l}"
             effort="${joint_limits['gripper_joint1']['limit']['effort']}"
             velocity="${joint_limits['gripper_joint1']['limit']['velocity']}"/>
      <mimic joint="${prefix}gripper_joint1" multiplier="-1" offset="0"/>
    </joint>
  </xacro:macro>
</robot>
