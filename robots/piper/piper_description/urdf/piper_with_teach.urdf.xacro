<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_with_teach">
  <xacro:include filename="$(find piper_description)/urdf/parts/piper_arm.xacro"/>
  <xacro:include filename="$(find piper_description)/urdf/parts/piper_teach.xacro"/>

  <xacro:piper_arm
    description_pkg="piper_description"/>

  <!-- libpiper::Model requires the canonical unprefixed `flange` frame. -->
  <link name="flange"/>
  <joint name="libpiper_flange_semantic_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="flange_link"/>
    <child link="flange"/>
  </joint>

  <xacro:piper_teach
    parent_link="flange"
    description_pkg="piper_description"/>
</robot>
